        ],
        "normal": [
          "Debug",
          "Release"
        ],
        "extensive": [
          "Debug",
          "Release"
        ]
      },
      "cmakeArgs": "-DSTORM_PORTABLE=ON -DSTORM_WARNING_AS_ERROR=ON",
      "baseImg": "movesrwth/storm-dependencies:latest"
