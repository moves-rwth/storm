    {
      "name": "GCC",
      "buildTypes": {
        "quick": [
          "Debug"
        ],
        "normal": [
          "Debug"
        ],
        "extensive": [
          "Debug",
          "Release"
        ]
      },
      "cmakeArgs": "-DCMAKE_C_COMPILER=gcc -DCMAKE_CXX_COMPILER=g++ -DSTORM_PORTABLE=ON -DSTORM_WARNING_AS_ERROR=ON",
      "setup": "pacman -Syu --noconfirm && pacman -S --noconfirm base-devel ccache cmake git boost cln ginac glpk gmp highs hwloc libarchive xerces-c z3",
      "baseImg": "archlinux:latest",
      "expectNotHave": [
        "CVC5",
        "GUROBI",
        "MATHSAT",
        "SOPLEX"
      ]
    },
    {
      "name": "Clang",
      "buildTypes": {
        "quick": [
          "Debug"
        ],
        "normal": [
          "Debug"
        ],
        "extensive": [
          "Debug",
          "Release"
        ]
      },
      "cmakeArgs": "-DCMAKE_C_COMPILER=clang -DCMAKE_CXX_COMPILER=clang++ -DSTORM_PORTABLE=ON -DSTORM_WARNING_AS_ERROR=ON",
      "setup": "pacman -Syu --noconfirm && pacman -S --noconfirm base-devel ccache cmake git boost cln ginac glpk gmp highs hwloc libarchive xerces-c z3 clang llvm",
      "baseImg": "archlinux:latest",
      "expectNotHave": [
        "CVC5",
        "GUROBI",
        "MATHSAT",
        "SOPLEX"
      ]
    },
    {
      "name": "musl",
      "buildTypes": {
        "extensive": [
          "Debug",
          "Release"
        ]
      },
      "cmakeArgs": "-DCMAKE_C_COMPILER=gcc -DCMAKE_CXX_COMPILER=g++ -DSTORM_PORTABLE=ON -DSTORM_WARNING_AS_ERROR=ON -DSTORM_DISABLE_HIGHS=ON",
      "setup": "apk add --no-cache bash ccache cmake make gcc g++ git autoconf automake libc-dev linux-headers patch boost-dev gmp-dev cln-dev ginac-dev glpk-dev libarchive-dev z3-dev ",
      "baseImg": "alpine:edge",
      "expectNotHave": [
        "CVC5",
        "GUROBI",
        "HIGHS",
        "MATHSAT",
        "SOPLEX",
        "XERCES"
      ]
    },
