          "Release"
        ]
      },
      "cmakeArgs": "-DSTORM_PORTABLE=ON -DSTORM_WARNING_AS_ERROR=ON",
      "baseImg": "movesrwth/storm-basesystem:minimal_dependencies",
      "disable_all": true,
      "ClnExact": false,
      "ClnRatfunc": false,
